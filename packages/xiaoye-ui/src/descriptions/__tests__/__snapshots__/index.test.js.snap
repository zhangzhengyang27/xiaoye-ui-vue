exports[`Descriptions > column is number 1`] = `
"<div class="xy-descriptions css-dev-only-do-not-override-1p3hq3p">
  <!---->
  <div class="xy-descriptions-view">
    <table>
      <tbody>
        <tr class="xy-descriptions-row">
          <td class="xy-descriptions-item" colspan="1">
            <div class="xy-descriptions-item-container"><span class="xy-descriptions-item-label">Product</span><span class="xy-descriptions-item-content">Cloud Database</span></div>
          </td>
          <td class="xy-descriptions-item" colspan="1">
            <div class="xy-descriptions-item-container"><span class="xy-descriptions-item-label">Billing</span><span class="xy-descriptions-item-content">Prepaid</span></div>
          </td>
          <td class="xy-descriptions-item" colspan="1">
            <div class="xy-descriptions-item-container"><span class="xy-descriptions-item-label">time</span><span class="xy-descriptions-item-content">18:00:00</span></div>
          </td>
        </tr>
        <tr class="xy-descriptions-row">
          <td class="xy-descriptions-item" colspan="3">
            <div class="xy-descriptions-item-container"><span class="xy-descriptions-item-label">Amount</span><span class="xy-descriptions-item-content">$80.00</span></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>"
`;

