// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Descriptions > Descriptions support colon 1`] = `
"<div class="xy-descriptions css-dev-only-do-not-override-1p3hq3p">
  <!---->
  <div class="xy-descriptions-view">
    <table>
      <tbody>
        <tr class="xy-descriptions-row">
          <td class="xy-descriptions-item" colspan="1">
            <div class="xy-descriptions-item-container"><span class="xy-descriptions-item-label xy-descriptions-item-no-colon">Product</span><span class="xy-descriptions-item-content">Cloud Database</span></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>"
`;

exports[`Descriptions > Descriptions support style 1`] = `
"<div style="background-color: rgb(232, 232, 232);" class="xy-descriptions css-dev-only-do-not-override-1p3hq3p">
