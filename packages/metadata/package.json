{
  "name": "@xiaoye-ui/metadata",
  "version": "6.0.0",
  "description": "XiaoyeUI component metadata for auto-import",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts",
    "postbuild": "node ../../scripts/prepare-dist-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "xiaoye-ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
