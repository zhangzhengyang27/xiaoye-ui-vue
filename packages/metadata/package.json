{
  "name": "@xiaoye-ui/metadata",
  "version": "6.0.1",
  "description": "XiaoyeUI component metadata for auto-import",
  "author": "xiaoye-ui",
  "homepage": "https://xiaoye-ui/",
  "license": "MIT",
  "repository": {
    "type": "git",
