{
  "name": "@xiaoye-ui/auto-import-resolver",
  "version": "6.0.0",
  "description": "XiaoyeUI auto-import resolver for unplugin-vue-components",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
