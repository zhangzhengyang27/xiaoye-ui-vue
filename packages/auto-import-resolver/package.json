{
  "name": "@xiaoye-ui/auto-import-resolver",
  "version": "6.0.0",
  "description": "XiaoyeUI auto-import resolver for unplugin-vue-components",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts",
    "postbuild": "node ../../scripts/prepare-dist-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xiaoye-ui/metadata": "workspace:*",
    "unplugin-vue-components": "^0.27.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
