{
    "name": "@xiaoye-ui/auto-import-resolver",
    "version": "6.1.0",
    "author": "xiaoye-ui",
    "description": "",
    "homepage": "https://xiaoye-ui/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/xiaoye-ui/xiaoye-ui.git",
        "directory": "packages/auto-import-resolver"
    },
    "bugs": {
        "url": "https://github.com/xiaoye-ui/xiaoye-ui/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "main": "./index.mjs",
        "module": "./index.mjs",
        "types": "./index.d.mts",
        "exports": {
            ".": {
                "types": "./index.d.mts",
                "import": "./index.mjs",
                "default": "./index.mjs"
            }
        },
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "scripts": {
        "build": "NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && tsup && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@xiaoye-ui/metadata": "workspace:*"
    },
    "devDependencies": {
        "tsup": "^8.1.0",
        "unplugin-vue-components": "^32.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
