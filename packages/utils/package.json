{
  "name": "@xiaoye-ui/utils",
  "version": "6.0.1",
  "author": "xiaoye-ui",
  "description": "XiaoyeUI utilities",
  "homepage": "https://xiaoye-ui/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoye-ui/xiaoye-ui.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/xiaoye-ui/xiaoye-ui/issues"
  },
  "keywords": [
    "vue",
    "vue.js",
    "vue3",
    "xiaoye-ui",
    "xiaoye-ui utils"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./object": {
      "types": "./src/object/index.ts",
      "import": "./src/object/index.ts"
    },
    "./dom": {
      "types": "./src/dom/index.ts",
      "import": "./src/dom/index.ts"
    },
    "./eventbus": {
      "types": "./src/eventbus/index.ts",
      "import": "./src/eventbus/index.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "import": "./src/storage.ts"
    },
    "./zindex": {
      "types": "./src/zindex/index.ts",
      "import": "./src/zindex/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/prepare-dist-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
