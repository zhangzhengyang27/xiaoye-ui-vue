{
  "name": "@xiaoye-ui/core",
  "version": "6.1.0",
  "description": "XiaoyeUI core runtime plugin",
  "author": "xiaoye-ui",
  "homepage": "https://xiaoye-ui/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoye-ui/xiaoye-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xiaoye-ui/xiaoye-ui/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./composables": {
      "types": "./src/composables/index.ts",
      "import": "./src/composables/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "node ../../scripts/prepare-dist-package.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@xiaoye-ui/utils": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
