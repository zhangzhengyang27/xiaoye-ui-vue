{
  "name": "xiaoye-ui",
  "compatibility_date": "2025-09-18",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "xiaoye-ui.github.io/*",
      "zone_name": "xiaoye-ui.github.io"
    },
    {
      "pattern": "www.xiaoye-ui.github.io/*",
      "zone_name": "xiaoye-ui.github.io"
    }
  ]
}
