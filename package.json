{
  "name": "@xiaoye-ui/monorepo",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "description": "XiaoyeUI monorepo - enterprise-class Vue 3 component library",
  "keywords": [
    "vue",
    "vue3",
    "design",
    "component",
    "components",
    "ui",
    "framework",
    "frontend",
    "xiaoye-ui"
  ],
  "scripts": {
    "dev": "pnpm --filter xiaoye-ui-docs dev",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter @xiaoye-ui/metadata build && pnpm --filter @xiaoye-ui/utils build && pnpm --filter @xiaoye-ui/core build && pnpm --filter @xiaoye-ui/icons build && pnpm --filter xiaoye-ui build && pnpm --filter @xiaoye-ui/auto-import-resolver build && pnpm --filter @xiaoye-ui/vite-plugin build && pnpm --filter @xiaoye-ui/nuxt-module build",
    "build:apps": "pnpm --filter xiaoye-ui-docs build",
    "test:unit": "pnpm --filter xiaoye-ui test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "release": "pnpm run build && pnpm recursive publish --filter './packages/*' --no-git-checks --report-summary",
    "prepare": "husky"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoye-ui/xiaoye-ui.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xiaoye-ui/xiaoye-ui/issues"
  },
  "homepage": "https://xiaoye-ui.github.io/",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.0.0",
    "@commitlint/config-conventional": "^12.0.0",
    "@types/fs-extra": "^9.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/test-utils": "^2.0.2",
    "@vueuse/core": "^8.3.1",
    "autoprefixer": "^10.2.0",
    "date-fns": "^2.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-markdown": "^2.2.1",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-vue": "^9.33.0",
    "fast-glob": "^3.2.7",
    "fs-extra": "^10.0.0",
    "glob": "^7.1.2",
    "husky": "^9.1.7",
    "less": "^4.0.0",
    "lint-staged": "^15.2.0",
    "markdown-it": "^8.4.2",
    "mockdate": "^2.0.2",
    "postcss": "^8.2.12",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^9.3.1",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.0.0",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx,vue}": "eslint --fix",
    "*.{js,mjs,jsx,ts,tsx,json,md,css,less,vue}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.8.3"
    }
  }
}
