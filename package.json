{
  "name": "@xiaoye-ui/monorepo",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "description": "XiaoyeUI monorepo - enterprise-class Vue 3 component library",
  "keywords": [
    "vue",
    "vue3",
    "design",
    "component",
    "components",
    "ui",
    "framework",
    "frontend",
    "xiaoye-ui"
  ],
  "scripts": {
    "dev": "pnpm --filter xiaoye-ui-docs dev",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter @xiaoye-ui/metadata build && pnpm --filter @xiaoye-ui/utils build && pnpm --filter @xiaoye-ui/core build && pnpm --filter @xiaoye-ui/icons build && pnpm --filter xiaoye-ui build && pnpm --filter @xiaoye-ui/auto-import-resolver build && pnpm --filter @xiaoye-ui/vite-plugin build && pnpm --filter @xiaoye-ui/nuxt-module build && pnpm --filter @xiaoye-ui/mcp build",
    "build:apps": "pnpm --filter xiaoye-ui-docs build",
    "test:unit": "pnpm --filter xiaoye-ui test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "release": "pnpm run build && pnpm recursive publish --filter './packages/*' --no-git-checks --report-summary",
    "prepare": "husky install"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoye-ui/xiaoye-ui.git"
  },
  "license": "MIT",
  "bugs": {
