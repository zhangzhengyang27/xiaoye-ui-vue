{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "xiaoye-ui": ["packages/xiaoye-ui/src/index.ts"],
      "xiaoye-ui/*": ["packages/xiaoye-ui/src/*"],
      "@xiaoye-ui/core": ["packages/core/src/index.ts"],
      "@xiaoye-ui/core/*": ["packages/core/src/*"],
      "@xiaoye-ui/icons": ["packages/icons/src/index.ts"],
      "@xiaoye-ui/icons/*": ["packages/icons/src/*"],
      "@xiaoye-ui/utils": ["packages/utils/src/index.ts"],
      "@xiaoye-ui/utils/*": ["packages/utils/src/*"]
    },
    "strictNullChecks": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "target": "es6",
    "allowJs": true
  },
  "exclude": ["node_modules", "**/dist/**/*", "**/lib/**/*", "**/es/**/*", "site/dist"]
}
